    {
      "id": "45736f52",
      "cell_type": "markdown",
      "source": [
        "## 生成正弦信号的叠加\n\n"
      ],
      "attachments": {},
      "metadata": {
        "name": "Название секции",
        "engee": {
          "isDisplay": true,
          "isParagraph": true,
          "isClosedParagraph": false,
          "amountHideCellsInside": 0,
