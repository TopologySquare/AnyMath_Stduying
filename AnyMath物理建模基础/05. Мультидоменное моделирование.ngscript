      "source": [
        "<div样式=\"文本对齐:中心;\">\n\n![5 задание 9 решение_2.png](attachment:5 задание 9 решение_2.png)\n\n</div>\n\n"
      ],
      "attachments": {
        "5 задание 9 решение_2.png": {
          "image/png": "data:image/png;base64,"
