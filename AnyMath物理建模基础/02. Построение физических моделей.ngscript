    {
      "id": "3804df61",
      "cell_type": "markdown",
      "source": [
        "<div样式=\"文本对齐:中心;\">\n\n![2 задание 11 решение - 1.png](attachment:2 задание 11 решение - 1.png)\n\n<br/>\n\n![2 задание 11 решение - 2.png](attachment:2 задание 11 решение - 2.png)\n\n</div>\n\n"
      ],
      "attachments": {
        "2 задание 11 решение - 1.png": {
          "image/png": "data:image/png;base64,"
        },
        "2 задание 11 решение - 2.png": {
