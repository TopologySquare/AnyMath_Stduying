      "id": "ed16cd5a",
      "cell_type": "markdown",
      "source": [
        "#### <span style=\"background-color:#c2ebff\">决定\n\n"
      ],
      "attachments": {},
      "metadata": {
        "name": "Название секции",
        "engee": {
          "isDisplay": true,
          "isParagraph": true,
          "isClosedParagraph": true,
          "amountHideCellsInside": 1,
