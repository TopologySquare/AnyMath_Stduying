      }
    },
    {
      "id": "cef917d6",
      "cell_type": "markdown",
      "source": [
        "<div样式=\"文本对齐:中心;\">\n\n![7 задание 3 решение_2.png](attachment:7 задание 3 решение_2.png)\n\n</div>\n\n"
      ],
      "attachments": {
        "7 задание 3 решение_2.png": {
