            "isAutoplayActive": false
          }
        }
      }
    },
    {
      "id": "603b03ae",
      "cell_type": "markdown",
      "source": [
        "###\r\n\r\n范围运算符允许您使用以下语法指定具有任意步长的数值： \r\n\r\n```\r\nstart:step:stop\r\n```\n\n"
      ],
      "attachments": {},
      "metadata": {
        "name": "Section title",
        "engee": {
          "isDisplay": true,
          "isParagraph": true,
          "isClosedParagraph": false,
