          "codeOutputHidden": false
        }
      }
    },
    {
      "id": "4c3cc631",
      "cell_type": "markdown",
      "source": [
        "示例。使用范围运算符，让我们定义一个从$10$到$20$、步长为$2$的整数向量：\n\n"
      ],
      "attachments": {},
      "metadata": {
        "name": "Section title",
        "engee": {
          "isDisplay": true,
          "isParagraph": false,
          "isClosedParagraph": false,
          "amountHideCellsInside": 0,
          "codeOutputView": "col",
          "codeOutputHidden": false
        }
      }
    },
    {
      "id": "306520ad",
      "cell_type": "code",
      "source": [
        "x = [10:2:20;]"
      ],
      "execution_count": 0,
      "outputs": [],
      "metadata": {
        "name": "Section title",
        "engee": {
          "isDisplay": true,
          "isParagraph": false,
          "isClosedParagraph": false,
