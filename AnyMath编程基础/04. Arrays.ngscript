            "scrollTop": 0
          },
          "maskInfo": {
            "isMaskVisible": true,
            "isEditorVisible": true,
            "isAutoplayActive": false
          }
        }
      }
    },
    {
      "id": "efabfc5a",
      "cell_type": "markdown",
      "source": [
        "#### <span style=\"background-color: #c2ebff\">解法</span>\n\n"
      ],
      "attachments": {},
      "metadata": {
        "name": "Section title",
        "engee": {
          "isDisplay": true,
          "isParagraph": true,
          "isClosedParagraph": true,
          "amountHideCellsInside": 1,
          "codeOutputView": "col",
          "codeOutputHidden": false
        }
      }
    },
    {
      "id": "1c6d55c3",
      "cell_type": "code",
      "source": [
        "x = [10:20;]"
      ],
      "execution_count": 0,
      "outputs": [],
      "metadata": {
        "name": "Section title",
        "engee": {
          "isDisplay": false,
          "isParagraph": false,
          "isClosedParagraph": false,
          "amountHideCellsInside": 0,
          "codeOutputView": "col",
          "codeOutputHidden": false,
          "outputInfo": {
            "isExpanded": false,
            "scrollTop": 0
          },
          "maskInfo": {
            "isMaskVisible": true,
