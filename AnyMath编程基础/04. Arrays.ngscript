      "cell_type": "code",
      "source": [
        "sum(A, dims=2)"
      ],
      "execution_count": 0,
      "outputs": [],
      "metadata": {
        "name": "Section title",
        "engee": {
          "isDisplay": true,
          "isParagraph": false,
          "isClosedParagraph": false,
