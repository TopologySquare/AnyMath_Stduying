    {
      "id": "41053ad6",
      "cell_type": "markdown",
      "source": [
        "#### <span style=\"background-color: #c2ebff\">Hint</span>\n\n"
      ],
      "attachments": {},
      "metadata": {
        "name": "Section title",
        "engee": {
          "isDisplay": true,
          "isParagraph": true,
          "isClosedParagraph": true,
