        "b = false"
      ],
      "execution_count": 0,
      "outputs": [],
      "metadata": {
        "name": "Section title",
        "engee": {
          "isDisplay": true,
          "isParagraph": false,
          "isClosedParagraph": false,
          "amountHideCellsInside": 0,
          "codeOutputView": "col",
          "codeOutputHidden": false,
          "outputInfo": {
            "isExpanded": false,
            "scrollTop": 0
          },
          "maskInfo": {
            "isMaskVisible": true,
            "isEditorVisible": true,
            "isAutoplayActive": false
          }
        }
      }
    },
    {
      "id": "cccbc1ba",
      "cell_type": "code",
      "source": [
        "c = 1 > 2"
      ],
      "execution_count": 0,
      "outputs": [],
      "metadata": {
        "name": "Section title",
        "engee": {
          "isDisplay": true,
          "isParagraph": false,
          "isClosedParagraph": false,
