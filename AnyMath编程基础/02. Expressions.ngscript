    {
      "id": "d050762d",
      "cell_type": "markdown",
      "source": [
        "### ✏️任务6\n\n"
      ],
      "attachments": {},
      "metadata": {
        "name": "Section title",
        "engee": {
          "isDisplay": true,
          "isParagraph": true,
          "isClosedParagraph": false,
          "amountHideCellsInside": 0,
          "codeOutputView": "col",
          "codeOutputHidden": false
        }
      }
    },
    {
      "id": "c0838c68",
      "cell_type": "markdown",
      "source": [
