            "isExpanded": false,
            "scrollTop": 0
          },
          "maskInfo": {
            "isMaskVisible": true,
            "isEditorVisible": true,
            "isAutoplayActive": false
          }
        }
      }
    },
    {
      "id": "4a5a1466",
      "cell_type": "markdown",
      "source": [
        "##### <span style=\"background-color: #c2ebff\">提示</span>\n\n"
      ],
      "attachments": {},
      "metadata": {
        "name": "Section title",
        "engee": {
          "isDisplay": true,
          "isParagraph": true,
          "isClosedParagraph": true,
          "amountHideCellsInside": 3,
          "codeOutputView": "col",
          "codeOutputHidden": false
        }
      }
    },
    {
      "id": "50d02e8b",
      "cell_type": "markdown",
      "source": [
        "在加法、乘法和幂运算符前必须加一个句点：`.+`，`.* `，`.^`。\n\n"
      ],
      "attachments": {},
      "metadata": {
        "name": "Section title",
        "engee": {
          "isDisplay": false,
          "isParagraph": false,
          "isClosedParagraph": false,
          "amountHideCellsInside": 0,
          "codeOutputView": "col",
          "codeOutputHidden": false
        }
      }
    },
    {
      "id": "97ba434d",
      "cell_type": "markdown",
      "source": [
        "###### <span style=\"background-color: #c2ebff\">解法</span>\n\n"
      ],
      "attachments": {},
      "metadata": {
        "name": "Section title",
        "engee": {
          "isDisplay": false,
          "isParagraph": true,
          "isClosedParagraph": true,
          "amountHideCellsInside": 1,
          "codeOutputView": "col",
          "codeOutputHidden": false
        }
      }
    },
    {
      "id": "a2b68116",
      "cell_type": "code",
      "source": [
        "x = [5 3 8 7 2]\r\ny = (x .^ 2 .+ 3 .* x .+ 1) .^ 5"
      ],
      "execution_count": 0,
      "outputs": [],
      "metadata": {
        "name": "Section title",
        "engee": {
          "isDisplay": false,
