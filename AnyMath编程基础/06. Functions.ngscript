          "amountHideCellsInside": 0,
          "codeOutputView": "col",
          "codeOutputHidden": false,
          "outputInfo": {
            "isExpanded": false,
            "scrollTop": 0
          },
          "maskInfo": {
            "isMaskVisible": true,
            "isEditorVisible": true,
            "isAutoplayActive": false
          }
        }
      }
    },
    {
      "id": "b1c2452e",
      "cell_type": "markdown",
      "source": [
        "#### <span style=\"background-color: #c2ebff\">解决方案</span>\n\n"
      ],
      "attachments": {},
      "metadata": {
        "name": "Section title",
        "engee": {
          "isDisplay": true,
          "isParagraph": true,
          "isClosedParagraph": true,
          "amountHideCellsInside": 2,
          "codeOutputView": "col",
          "codeOutputHidden": false
        }
      }
    },
    {
      "id": "e52e46e5",
      "cell_type": "code",
      "source": [
        "function func(x,y,z)\r\n    sin(x+y+z)\r\nend"
      ],
