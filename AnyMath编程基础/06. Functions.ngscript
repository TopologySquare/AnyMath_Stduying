    },
    {
      "id": "0f15b0e9",
      "cell_type": "code",
      "source": [
        "println(global_var)"
      ],
      "execution_count": 0,
      "outputs": [],
      "metadata": {
        "name": "Section title",
        "engee": {
          "isDisplay": true,
          "isParagraph": false,
          "isClosedParagraph": false,
