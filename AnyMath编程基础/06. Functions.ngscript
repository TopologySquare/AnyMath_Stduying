          }
        }
      }
    },
    {
      "id": "952143e5",
      "cell_type": "code",
      "source": [
        "func(pi/4, pi/3, pi/5)"
      ],
      "execution_count": 0,
      "outputs": [],
      "metadata": {
        "name": "Section title",
