    },
    {
      "id": "6ceac51c",
      "cell_type": "markdown",
      "source": [
        "#### <span style=\"background-color: #c2ebff\">Solution</span>\n\n"
      ],
      "attachments": {},
      "metadata": {
        "name": "Section title",
        "engee": {
          "isDisplay": true,
          "isParagraph": true,
